{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoCulling",
  "version": "0.1.0",
  "identifier": "com.autoculling.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AutoCulling",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": { "width": 620, "height": 420 },
        "windowPosition": { "x": 10, "y": 38 },
        "appPosition": { "x": 140, "y": 221 },
        "applicationFolderPosition": { "x": 481, "y": 221 }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese",
          "English",
          "TradChinese"
        ],
        "displayLanguageSelector": true
      }
    },
    "resources": {
      "resources/sidecar": "resources/sidecar",
      "resources/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
